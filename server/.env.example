# ─────────────────────────────────────────────────────────────
# Student Community Platform — Server Environment Variables
# Copy this file to ".env" in the same folder and fill in values.
#   cp .env.example .env
# Never commit the real ".env" file (it is already in .gitignore).
# ─────────────────────────────────────────────────────────────

# --- Core (required) ---------------------------------------------------
PORT=5050
NODE_ENV=development

# MongoDB connection string.
# Local dev example:      mongodb://127.0.0.1:27017/student-community-platform
# MongoDB Atlas example:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/student-community-platform
MONGO_URI=

# Secret used to sign JWTs. Must be a long, random string.
# In production this MUST be at least 32 characters (enforced by config/security.js).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long issued JWTs stay valid.
JWT_EXPIRES_IN=7d

# The URL of the frontend app. Used for CORS allow-list and for links
# inside verification/reset emails.
CLIENT_URL=http://localhost:5175

# --- Admin bootstrap (required to have an admin account) ---------------
# The email listed here is auto-promoted to "admin" on every server
# startup. Only this account can grant/revoke admin access to others.
SUPER_ADMIN_EMAIL=

# --- Google Sign-In (optional) -----------------------------------------
# Leave blank to disable "Sign in with Google". If set, the matching
# VITE_GOOGLE_CLIENT_ID must also be set in client/.env.
GOOGLE_CLIENT_ID=

# --- Transactional email via Brevo (optional but recommended) ---------
# Needed for OTP/verification emails and password-reset emails.
# Without BREVO_API_KEY, those endpoints will respond with a clear
# "email service not configured" error instead of failing silently.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Student Community Platform

# --- CORS (optional) -----------------------------------------------------
# Comma-separated list of additional allowed origins besides CLIENT_URL
# and the localhost defaults (useful for staging URLs, custom domains).
# Example: CORS_ORIGINS=https://staging.example.com,https://app.example.com
CORS_ORIGINS=
